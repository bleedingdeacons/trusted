{
    "name": "trusted/trusted",
    "description": "Trusted — a 7-day telephone shift rota manager for WordPress, built on the Unity plugin.",
    "type": "wordpress-plugin",
    "license": "MIT (Modified)",
    "require": {
        "php": ">=8.1",
        "psr/container": "^1.1 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Trusted\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "Trusted\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=.phpcs.xml.dist",
        "phpcs:fix": "phpcbf --standard=.phpcs.xml.dist",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "build:production": "php build.php build:production",
        "build:dev": "php build.php build:dev",
        "build:clean": "php build.php clean"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bleedingdeacons/wp-mocks"
        }
    ],
    "require-dev": {
        "bleedingdeacons/wp-mocks": "^1.5.2",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    }
}
